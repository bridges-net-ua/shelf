# ----- Shelf specifics -----
# Local-only "maybe-trash" folder for files that aren't used by the app
# or git but might still be useful (see NoData/README.md).
NoData/

# Legacy widget projects (from the initial Помічник → Polychka → Shelf rename
# chain). Patterns kept as a safety net even though the folders themselves
# were deleted - in case anything similar reappears.
WidgetPlugins/Помічник.Widgets.*/
WidgetPlugins/Polychka.Widgets.*/

# App runtime artifacts and exports
artifacts/
shelf-*.json
shelf-*.txt
polychka-*.json
polychka-*.txt
birth.txt
dates.txt
out.log
err.log
logodesk.png

# Backup files
Resources/shelf.ico.bak
*.bak

# OS junk
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# ----- Local secrets / config overrides (none expected, but reserve) -----
*.env
*.env.local
appsettings.Local.json

# ----- Code signing (per-dev self-signed certs for local MSIX testing) -----
# .cer is the public key (safe but per-developer). .pfx contains the
# private key and MUST NEVER be committed. Generated by tools/make-msix.ps1 -Sign.
*.cer
*.pfx
shelf-cert.*
