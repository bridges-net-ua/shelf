<Window x:Class="Shelf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource App_Name}"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource UiFont}"
        Width="300" Height="800"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                x:Name="PinnedBorder"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Visibility="Collapsed">
            <ScrollViewer x:Name="PinnedScroll"
                          Style="{DynamicResource OverlayPanelScrollViewer}">
                <StackPanel x:Name="PinnedHost"/>
            </ScrollViewer>
        </Border>

        <ScrollViewer Grid.Row="1"
                      x:Name="PanelScroll"
                      Style="{DynamicResource OverlayPanelScrollViewer}">
            <StackPanel x:Name="WidgetsHost"/>
        </ScrollViewer>
        <Canvas Grid.Row="1"
                x:Name="DragOverlay"
                IsHitTestVisible="False"
                ClipToBounds="True"/>

        <!-- Minute of silence: dims the whole panel and shows a 60s countdown -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                x:Name="SilenceOverlay"
                Background="#E6000000"
                Visibility="Collapsed"
                Panel.ZIndex="100">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="SilenceCountdown"
                           Text="60"
                           FontSize="60" FontWeight="Bold"
                           Foreground="#FFFFFFFF"
                           Typography.NumeralAlignment="Tabular"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{DynamicResource Silence_Title}"
                           FontSize="14"
                           Foreground="#CCFFFFFF"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="12,8,12,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
