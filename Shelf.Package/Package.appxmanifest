<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for Shelf (UI brand: "Поличка" uk / "ShelfDesk" en).

  Identity values (Name, Publisher) are the PRODUCTION values issued by
  Microsoft Partner Center for the reserved product "ShelfDesk":
    Store URL: https://apps.microsoft.com/detail/9NFC2DKPQDLJ
    Store ID:  9NFC2DKPQDLJ
    PFN:       BridgesCommunity.ShelfDesk_a09jnsmnpx15r

  Microsoft Store re-signs uploaded packages with its own CA, so the local
  make-msix.ps1 pipeline produces UNSIGNED MSIX by default. For local
  sideload testing, run make-msix.ps1 -Sign which generates a self-signed
  cert whose Subject must equal the Publisher below - that requires an
  admin step to trust the cert in LocalMachine\Root.

  DisplayName in this manifest is "ShelfDesk" to match the Store product
  name (required by certification). The localised display name "Поличка"
  for uk-UA market is configured separately in Partner Center → Store
  listings, not here.

  TaskId "ShelfAutoStart" must match Services/AutoStartService.cs StartupTaskId.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  IgnorableNamespaces="uap rescap desktop">

  <Identity
    Name="BridgesCommunity.ShelfDesk"
    Publisher="CN=01B4C228-C24C-45F3-AF31-805FFA0F72FF"
    Version="1.1.1.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>ShelfDesk</DisplayName>
    <PublisherDisplayName>Bridges Community</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Customizable widget dock for the Windows desktop</Description>
  </Properties>

  <Dependencies>
    <!-- MinVersion matches Shelf.csproj TargetFramework net8.0-windows10.0.19041.0 (Win10 2004). -->
    <TargetDeviceFamily Name="Windows.Desktop"
                        MinVersion="10.0.19041.0"
                        MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="uk-UA" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="App"
                 Executable="Shelf.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="ShelfDesk"
        Description="Customizable widget dock for the Windows desktop"
        BackgroundColor="#2A2A30"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          ShortName="ShelfDesk" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#2A2A30" />
      </uap:VisualElements>

      <Extensions>
        <!-- Autostart on user login. Disabled by default — user opts in via
             Shelf Settings, which calls Windows.ApplicationModel.StartupTask
             with this exact TaskId. -->
        <desktop:Extension Category="windows.startupTask"
                           Executable="Shelf.exe"
                           EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask
            TaskId="ShelfAutoStart"
            Enabled="false"
            DisplayName="ShelfDesk" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- runFullTrust is required for WPF+WinForms hybrid apps to use Win32
         APIs (AppBar, NotifyIcon, registry where still applicable). Available
         only to Desktop Bridge packages. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
