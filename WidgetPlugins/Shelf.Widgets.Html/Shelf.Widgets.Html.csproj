<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
    <RootNamespace>Shelf.Widgets.Html</RootNamespace>
    <AssemblyName>Shelf.Widgets.Html</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- The one external dependency in the whole widget fleet - a deliberate
         exception to the single-DLL convention. WebView2Loader.dll (native) and
         the two managed WebView2 assemblies flow to the host output through the
         host's ProjectReference automatically. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.51" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shelf.Sdk\Shelf.Sdk.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

</Project>
