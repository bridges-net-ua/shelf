<Window x:Class="Shelf.Widgets.Html.HtmlSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Html_Settings_Title}"
        Height="560" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{DynamicResource UiFont}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{DynamicResource Html_Code_Label}"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   FontSize="13" FontWeight="SemiBold"
                   Margin="0,0,0,6"/>

        <TextBox Grid.Row="1"
                 x:Name="CodeBox"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Cascadia Mono, Consolas, Courier New"
                 FontSize="12"
                 Padding="8,6"
                 Background="{DynamicResource ElevatedSurfaceBrush}"
                 Foreground="{DynamicResource PrimaryTextBrush}"
                 CaretBrush="{DynamicResource PrimaryTextBrush}"
                 SelectionBrush="{DynamicResource AccentBrush}"
                 BorderBrush="{DynamicResource BorderBrush}"
                 BorderThickness="1"/>

        <TextBlock Grid.Row="2"
                   Text="{DynamicResource Html_Code_Hint}"
                   Foreground="{DynamicResource MutedTextBrush}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"/>

        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Margin="0,0,0,6"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="13" FontWeight="SemiBold">
                <Run Text="{DynamicResource Html_FieldHeight}"/>
                <Run x:Name="HeightValueRun" Text="200"/>
                <Run Text="{DynamicResource Settings_Px}"/>
            </TextBlock>
            <Slider x:Name="HeightSlider"
                    Minimum="80" Maximum="600"
                    TickFrequency="10"
                    IsSnapToTickEnabled="True"
                    ValueChanged="Slider_ValueChanged"/>
        </StackPanel>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="{DynamicResource Btn_Cancel}"
                    Click="Cancel_Click"
                    MinWidth="90"
                    Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Btn_OK}"
                    Click="Ok_Click"
                    MinWidth="90"
                    Background="{DynamicResource AccentBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"/>
        </StackPanel>
    </Grid>
</Window>
