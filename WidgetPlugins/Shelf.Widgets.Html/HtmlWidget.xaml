<UserControl x:Class="Shelf.Widgets.Html.HtmlWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Border Padding="4"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== Header: title + reload ===== -->
            <Grid Grid.Row="0" Margin="2,0,2,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" HorizontalAlignment="Left">
                    <TextBlock x:Name="TitleText"
                               Text="{DynamicResource Html_Name}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Center"
                               Background="Transparent"
                               Cursor="IBeam"
                               ToolTip="{DynamicResource Tip_Rename}"
                               MouseLeftButtonDown="TitleText_MouseLeftButtonDown">
                        <TextBlock.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{DynamicResource Menu_Rename}" Click="TitleRenameMenuItem_Click">
                                    <MenuItem.Icon>
                                        <Viewbox Width="16" Height="16" Margin="0,0,10,0">
                                            <Path Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                                  Fill="{DynamicResource PrimaryTextBrush}"/>
                                        </Viewbox>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </TextBlock.ContextMenu>
                    </TextBlock>
                    <TextBox x:Name="TitleEdit"
                             Visibility="Collapsed"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Background="{DynamicResource ElevatedSurfaceBrush}"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             CaretBrush="{DynamicResource PrimaryTextBrush}"
                             SelectionBrush="{DynamicResource AccentBrush}"
                             BorderBrush="{DynamicResource AccentBrush}"
                             BorderThickness="1"
                             Padding="4,1"
                             MinWidth="100"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Left"
                             PreviewKeyDown="TitleEdit_PreviewKeyDown"
                             LostFocus="TitleEdit_LostFocus"/>
                </Grid>

                <Button x:Name="ReloadButton"
                        Grid.Column="1"
                        Style="{DynamicResource IconButtonSubtle}"
                        Width="22" Height="22"
                        Click="ReloadButton_Click"
                        ToolTip="{DynamicResource Html_Tip_Reload}">
                    <Viewbox Width="14" Height="14">
                        <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                              Fill="{DynamicResource SecondaryTextBrush}"/>
                    </Viewbox>
                </Button>
            </Grid>

            <!-- ===== Content: the embedded browser ===== -->
            <Grid Grid.Row="1">
                <wv2:WebView2 x:Name="Web" Height="200"/>
                <TextBlock x:Name="ErrorText"
                           Visibility="Collapsed"
                           FontSize="11"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="8"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
