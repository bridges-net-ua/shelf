<Window x:Class="Shelf.Widgets.Holidays.HolidayEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Holidays_Editor_Title_Add}"
        Height="560" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{DynamicResource UiFont}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="{DynamicResource Holidays_Name_Label}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="13" FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="NameBox"
                         Padding="6,4"
                         Background="{DynamicResource ElevatedSurfaceBrush}"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         CaretBrush="{DynamicResource PrimaryTextBrush}"
                         SelectionBrush="{DynamicResource AccentBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         BorderThickness="1"
                         FontSize="13"/>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Holidays_Month_Label}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <ComboBox x:Name="MonthCombo"
                                  SelectionChanged="MonthCombo_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource Holidays_Day_Label}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <ComboBox x:Name="DayCombo"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{DynamicResource Holidays_Year_Label}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="13" FontWeight="SemiBold"
                           Margin="0,16,0,6"/>
                <ComboBox x:Name="YearCombo" Width="150" HorizontalAlignment="Left"/>

                <TextBlock Text="{DynamicResource Holidays_Note_Label}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="13" FontWeight="SemiBold"
                           Margin="0,16,0,6"/>
                <TextBox x:Name="NoteBox"
                         Padding="6,4"
                         Background="{DynamicResource ElevatedSurfaceBrush}"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         CaretBrush="{DynamicResource PrimaryTextBrush}"
                         SelectionBrush="{DynamicResource AccentBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         BorderThickness="1"
                         FontSize="13"/>

                <TextBlock Text="{DynamicResource Holidays_Icon_Label}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="13" FontWeight="SemiBold"
                           Margin="0,16,0,6"/>
                <ListBox x:Name="IconPalette"
                         Background="Transparent"
                         BorderThickness="0"
                         HorizontalAlignment="Left"
                         SelectionChanged="IconPalette_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="6"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="3"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3"
                                                Padding="{TemplateBinding Padding}"
                                                Width="44" Height="40"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource HoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush"
                                                        Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource HoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="DeleteButton"
                    Grid.Column="0"
                    Content="{DynamicResource Holidays_Remove}"
                    Click="Delete_Click"
                    MinWidth="90"
                    Visibility="Collapsed"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="{DynamicResource Btn_Cancel}"
                        Click="Cancel_Click"
                        MinWidth="90"
                        Margin="0,0,8,0"/>
                <Button x:Name="OkButton"
                        Click="Ok_Click"
                        MinWidth="90"
                        Background="{DynamicResource AccentBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        Content="{DynamicResource Holidays_Add}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
