<Window x:Class="Shelf.Widgets.Currency.CurrencySettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Currency_Settings_Title}"
        Height="380" Width="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{DynamicResource UiFont}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{DynamicResource Currency_Section_Currencies}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="11" FontWeight="SemiBold"
                       Margin="0,0,0,6"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                <StackPanel x:Name="CurrencyHost"/>
            </ScrollViewer>

            <CheckBox x:Name="ShowChangeBox"
                      Content="{DynamicResource Currency_Opt_ShowChange}"
                      Margin="0,16,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="{DynamicResource Btn_Cancel}"
                    Click="Cancel_Click"
                    MinWidth="90"
                    Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Btn_OK}"
                    Click="Ok_Click"
                    MinWidth="90"
                    Background="{DynamicResource AccentBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"/>
        </StackPanel>
    </Grid>
</Window>
