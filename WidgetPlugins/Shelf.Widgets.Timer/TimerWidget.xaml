<UserControl x:Class="Shelf.Widgets.Timer.TimerWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>

        <Style x:Key="TimerActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="10,7"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TimerPrimaryButton" TargetType="Button" BasedOn="{StaticResource TimerActionButton}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="TopLight"
                                        Height="13"
                                        Margin="1"
                                        VerticalAlignment="Top"
                                        CornerRadius="5,5,3,3"
                                        Background="#24FFFFFF"/>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="10,7"
                                                  RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                <Setter TargetName="TopLight" Property="Background" Value="#30FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                <Setter TargetName="TopLight" Property="Opacity" Value="0.35"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TimerDigitBox" TargetType="TextBox">
            <Setter Property="Width" Value="54"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="FontSize" Value="27"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Setter Property="MaxLength" Value="2"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="StepButton" TargetType="RepeatButton">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Width" Value="54"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresetButton" TargetType="Button" BasedOn="{StaticResource TimerActionButton}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="MinWidth" Value="50"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="8,4"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Padding="4"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Renameable title -->
            <Grid Grid.Row="0" Margin="2,0,2,7" HorizontalAlignment="Stretch">
                <TextBlock x:Name="TitleText"
                           Text="{DynamicResource Timer_Name}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedTextBrush}"
                           VerticalAlignment="Center"
                           Background="Transparent"
                           Cursor="IBeam"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{DynamicResource Tip_Rename}"
                           MouseLeftButtonDown="TitleText_MouseLeftButtonDown">
                    <TextBlock.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{DynamicResource Menu_Rename}" Click="TitleRenameMenuItem_Click">
                                <MenuItem.Icon>
                                    <Viewbox Width="16" Height="16" Margin="0,0,10,0">
                                        <Path Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                              Fill="{DynamicResource PrimaryTextBrush}"/>
                                    </Viewbox>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </TextBlock.ContextMenu>
                </TextBlock>
                <TextBox x:Name="TitleEdit"
                         Visibility="Collapsed"
                         FontSize="11"
                         FontWeight="SemiBold"
                         Background="{DynamicResource ElevatedSurfaceBrush}"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         CaretBrush="{DynamicResource PrimaryTextBrush}"
                         SelectionBrush="{DynamicResource AccentBrush}"
                         BorderBrush="{DynamicResource AccentBrush}"
                         BorderThickness="1"
                         Padding="4,1"
                         MinWidth="120"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Left"
                         PreviewKeyDown="TitleEdit_PreviewKeyDown"
                         LostFocus="TitleEdit_LostFocus"/>
            </Grid>

            <Border Grid.Row="1"
                    Background="{DynamicResource ElevatedSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10">
                <StackPanel>
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,9">
                        <Grid>
                            <!-- Idle: editable hh:mm:ss digit boxes + ▲▼ steppers -->
                            <Grid x:Name="TimerEditArea" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <RepeatButton Tag="h+" Style="{StaticResource StepButton}" Content="▲" Click="Step_Click"/>
                                    <TextBox x:Name="HoursBox"
                                             Style="{StaticResource TimerDigitBox}"
                                             PreviewTextInput="DigitOnly_PreviewTextInput"
                                             LostFocus="TimeBox_LostFocus"/>
                                    <TextBlock Text="{DynamicResource Timer_Unit_Hours}"
                                               FontSize="9"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               HorizontalAlignment="Center"/>
                                    <RepeatButton Tag="h-" Style="{StaticResource StepButton}" Content="▼" Click="Step_Click" Margin="0,4,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text=":"
                                           FontSize="27"
                                           FontWeight="SemiBold"
                                           FontFamily="{DynamicResource UiFont}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="5,0,5,18"/>

                                <StackPanel Grid.Column="2">
                                    <RepeatButton Tag="m+" Style="{StaticResource StepButton}" Content="▲" Click="Step_Click"/>
                                    <TextBox x:Name="MinutesBox"
                                             Style="{StaticResource TimerDigitBox}"
                                             PreviewTextInput="DigitOnly_PreviewTextInput"
                                             LostFocus="TimeBox_LostFocus"/>
                                    <TextBlock Text="{DynamicResource Timer_Unit_Minutes}"
                                               FontSize="9"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               HorizontalAlignment="Center"/>
                                    <RepeatButton Tag="m-" Style="{StaticResource StepButton}" Content="▼" Click="Step_Click" Margin="0,4,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Column="3"
                                           Text=":"
                                           FontSize="27"
                                           FontWeight="SemiBold"
                                           FontFamily="{DynamicResource UiFont}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="5,0,5,18"/>

                                <StackPanel Grid.Column="4">
                                    <RepeatButton Tag="s+" Style="{StaticResource StepButton}" Content="▲" Click="Step_Click"/>
                                    <TextBox x:Name="SecondsBox"
                                             Style="{StaticResource TimerDigitBox}"
                                             PreviewTextInput="DigitOnly_PreviewTextInput"
                                             LostFocus="TimeBox_LostFocus"/>
                                    <TextBlock Text="{DynamicResource Timer_Unit_Seconds}"
                                               FontSize="9"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               HorizontalAlignment="Center"/>
                                    <RepeatButton Tag="s-" Style="{StaticResource StepButton}" Content="▼" Click="Step_Click" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Running/finished: large hh:mm:ss display + "час вийшов" status -->
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="TimerDisplay"
                                           Visibility="Collapsed"
                                           Text="00:00:00"
                                           FontSize="41"
                                           FontWeight="SemiBold"
                                           FontFamily="{DynamicResource UiFont}"
                                           Typography.NumeralAlignment="Tabular"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           HorizontalAlignment="Center"/>

                                <TextBlock x:Name="TimerStatusText"
                                           Visibility="Collapsed"
                                           Text="{DynamicResource Timer_Done}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel x:Name="TimerPresets"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,10,0,0">
                        <Button x:Name="Preset1" Style="{StaticResource PresetButton}" Tag="1" Click="Preset_Click"/>
                        <Button x:Name="Preset5" Style="{StaticResource PresetButton}" Tag="5" Click="Preset_Click"/>
                        <Button x:Name="Preset10" Style="{StaticResource PresetButton}" Tag="10" Click="Preset_Click"/>
                        <Button x:Name="Preset25" Style="{StaticResource PresetButton}" Tag="25" Click="Preset_Click"/>
                    </StackPanel>

                    <Grid Margin="0,11,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="TimerLeftButton"
                                Grid.Column="0"
                                Style="{StaticResource TimerActionButton}"
                                Content="{DynamicResource Timer_Reset}"
                                Click="TimerLeftButton_Click"/>
                        <Button x:Name="TimerRightButton"
                                Grid.Column="2"
                                Style="{StaticResource TimerPrimaryButton}"
                                Content="{DynamicResource Timer_Start}"
                                Click="TimerRightButton_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
