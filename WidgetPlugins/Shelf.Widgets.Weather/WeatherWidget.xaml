<UserControl x:Class="Shelf.Widgets.Weather.WeatherWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="12,8,12,10"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== Header: title + last-update + refresh ===== -->
            <Grid Grid.Row="0" Margin="2,0,2,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" HorizontalAlignment="Left">
                    <TextBlock x:Name="TitleText"
                               Text="{DynamicResource Weather_Name}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Center"
                               Background="Transparent"
                               Cursor="IBeam"
                               ToolTip="{DynamicResource Tip_Rename}"
                               MouseLeftButtonDown="TitleText_MouseLeftButtonDown">
                        <TextBlock.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{DynamicResource Menu_Rename}" Click="TitleRenameMenuItem_Click">
                                    <MenuItem.Icon>
                                        <Viewbox Width="16" Height="16" Margin="0,0,10,0">
                                            <Path Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                                  Fill="{DynamicResource PrimaryTextBrush}"/>
                                        </Viewbox>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </TextBlock.ContextMenu>
                    </TextBlock>
                    <TextBox x:Name="TitleEdit"
                             Visibility="Collapsed"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Background="{DynamicResource ElevatedSurfaceBrush}"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             CaretBrush="{DynamicResource PrimaryTextBrush}"
                             SelectionBrush="{DynamicResource AccentBrush}"
                             BorderBrush="{DynamicResource AccentBrush}"
                             BorderThickness="1"
                             Padding="4,1"
                             MinWidth="100"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Left"
                             PreviewKeyDown="TitleEdit_PreviewKeyDown"
                             LostFocus="TitleEdit_LostFocus"/>
                </Grid>

                <TextBlock x:Name="UpdatedText"
                           Grid.Column="1"
                           Text=""
                           FontSize="11"
                           Foreground="{DynamicResource MutedTextBrush}"
                           VerticalAlignment="Center"
                           Margin="8,0,6,0"/>

                <Button x:Name="RefreshButton"
                        Grid.Column="2"
                        Style="{DynamicResource IconButtonSubtle}"
                        Width="22" Height="22"
                        Click="RefreshButton_Click"
                        ToolTip="{DynamicResource Tip_Refresh}">
                    <Viewbox Width="14" Height="14">
                        <Path x:Name="RefreshIconPath"
                              Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                              Fill="{DynamicResource SecondaryTextBrush}"/>
                    </Viewbox>
                </Button>
            </Grid>

            <!-- ===== Content ===== -->
            <Border Grid.Row="1"
                    Background="{DynamicResource ElevatedSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,7,10,8">
                <StackPanel>
                    <TextBlock x:Name="CityText"
                               Text=""
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center"/>

                    <!-- Today -->
                    <Grid x:Name="TodayBlock" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Viewbox Grid.Column="0"
                                 Width="38" Height="38"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0">
                            <Path x:Name="TodayIconPath"
                                  Fill="{DynamicResource PrimaryTextBrush}"/>
                        </Viewbox>

                        <TextBlock x:Name="TodayTempText"
                                   Grid.Column="1"
                                   Text="--"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock x:Name="TodayDescText"
                                       Text=""
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TodayMetaText"
                                       Text=""
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="DaySeparator"
                            Height="1"
                            Background="{DynamicResource BorderBrush}"
                            Margin="0,6,0,6"/>

                    <!-- Tomorrow -->
                    <Grid x:Name="TomorrowBlock">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Viewbox Grid.Column="0"
                                 Width="22" Height="22"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0">
                            <Path x:Name="TomorrowIconPath"
                                  Fill="{DynamicResource SecondaryTextBrush}"/>
                        </Viewbox>

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,8,0"><Run Text="{DynamicResource Weather_Tomorrow}"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource SecondaryTextBrush}"/><Run x:Name="TomorrowDescRun"
                                        FontSize="11"
                                        Foreground="{DynamicResource MutedTextBrush}"/></TextBlock>

                        <TextBlock x:Name="TomorrowHiLoText"
                                   Grid.Column="2"
                                   Text=""
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock x:Name="ErrorText"
                               Visibility="Collapsed"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
