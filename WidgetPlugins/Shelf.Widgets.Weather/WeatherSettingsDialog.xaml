<Window x:Class="Shelf.Widgets.Weather.WeatherSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Weather_Settings_Title}"
        Height="220" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{DynamicResource UiFont}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{DynamicResource Weather_City_Label}"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="13" FontWeight="SemiBold"
                       Margin="0,0,0,6"/>
            <TextBox x:Name="CityBox"
                     Padding="6,4"
                     Background="{DynamicResource ElevatedSurfaceBrush}"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     CaretBrush="{DynamicResource PrimaryTextBrush}"
                     SelectionBrush="{DynamicResource AccentBrush}"
                     BorderBrush="{DynamicResource BorderBrush}"
                     BorderThickness="1"
                     FontSize="13"
                     KeyDown="CityBox_KeyDown"/>

            <TextBlock Text="{DynamicResource Weather_City_Hint}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="{DynamicResource Btn_Cancel}"
                    Click="Cancel_Click"
                    MinWidth="90"
                    Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Btn_OK}"
                    Click="Ok_Click"
                    MinWidth="90"
                    Background="{DynamicResource AccentBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"/>
        </StackPanel>
    </Grid>
</Window>
