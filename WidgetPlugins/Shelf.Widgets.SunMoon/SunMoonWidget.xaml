<UserControl x:Class="Shelf.Widgets.SunMoon.SunMoonWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="4"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== Header: title + last-update + refresh ===== -->
            <Grid Grid.Row="0" Margin="2,0,2,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" HorizontalAlignment="Left">
                    <TextBlock x:Name="TitleText"
                               Text="{DynamicResource SunMoon_Name}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Center"
                               Background="Transparent"
                               Cursor="IBeam"
                               ToolTip="{DynamicResource Tip_Rename}"
                               MouseLeftButtonDown="TitleText_MouseLeftButtonDown">
                        <TextBlock.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{DynamicResource Menu_Rename}" Click="TitleRenameMenuItem_Click">
                                    <MenuItem.Icon>
                                        <Viewbox Width="16" Height="16" Margin="0,0,10,0">
                                            <Path Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                                  Fill="{DynamicResource PrimaryTextBrush}"/>
                                        </Viewbox>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </TextBlock.ContextMenu>
                    </TextBlock>
                    <TextBox x:Name="TitleEdit"
                             Visibility="Collapsed"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Background="{DynamicResource ElevatedSurfaceBrush}"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             CaretBrush="{DynamicResource PrimaryTextBrush}"
                             SelectionBrush="{DynamicResource AccentBrush}"
                             BorderBrush="{DynamicResource AccentBrush}"
                             BorderThickness="1"
                             Padding="4,1"
                             MinWidth="100"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Left"
                             PreviewKeyDown="TitleEdit_PreviewKeyDown"
                             LostFocus="TitleEdit_LostFocus"/>
                </Grid>

                <TextBlock x:Name="UpdatedText"
                           Grid.Column="1"
                           Text=""
                           FontSize="11"
                           Foreground="{DynamicResource MutedTextBrush}"
                           VerticalAlignment="Center"
                           Margin="8,0,6,0"/>

                <Button x:Name="RefreshButton"
                        Grid.Column="2"
                        Style="{DynamicResource IconButtonSubtle}"
                        Width="22" Height="22"
                        Click="RefreshButton_Click"
                        ToolTip="{DynamicResource Tip_Refresh}">
                    <Viewbox Width="14" Height="14">
                        <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                              Fill="{DynamicResource SecondaryTextBrush}"/>
                    </Viewbox>
                </Button>
            </Grid>

            <!-- ===== Content (everything centered) ===== -->
            <Border Grid.Row="1"
                    Background="{DynamicResource ElevatedSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,7,10,8">
                <StackPanel>
                    <TextBlock x:Name="CityText"
                               Text=""
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>

                    <!-- Sun block (toggled by ShowSun): polar notice + sunrise/sunset core -->
                    <Border x:Name="SunSep" Height="1" Background="{DynamicResource BorderBrush}" Margin="0,6,0,6"/>
                    <StackPanel x:Name="SunBlock">
                    <!-- Polar day/night notice (replaces sunrise/sunset when relevant) -->
                    <TextBlock x:Name="PolarText"
                               Visibility="Collapsed"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,2,0,4"/>

                    <!-- Sun core: sunrise (left) | single sun (center) | sunset (right) -->
                    <Grid x:Name="SunCore">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{DynamicResource SunMoon_Sunrise}"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="SunriseText" Text="--:--"
                                       FontSize="19" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <Viewbox Grid.Column="1" Width="34" Height="34"
                                 VerticalAlignment="Center" Margin="10,0,10,0">
                            <Path Data="M3.55,18.54L4.96,19.95L6.76,18.16L5.34,16.74M11,22.45C11.32,22.45 13,22.45 13,22.45V19.5H11M12,5.5A6.5,6.5 0 0,0 5.5,12A6.5,6.5 0 0,0 12,18.5A6.5,6.5 0 0,0 18.5,12A6.5,6.5 0 0,0 12,5.5M20,13H23V11H20M17.24,18.16L19.04,19.95L20.45,18.54L18.66,16.74M20.45,5.46L19.04,4.05L17.24,5.84L18.66,7.26M13,1.55H11V4.5H13M6.76,5.84L4.96,4.05L3.55,5.46L5.34,7.26L6.76,5.84M1,13H4V11H1V13Z"
                                  Fill="{DynamicResource PrimaryTextBrush}"/>
                        </Viewbox>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{DynamicResource SunMoon_Sunset}"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="SunsetText" Text="--:--"
                                       FontSize="19" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    </StackPanel>

                    <!-- Day length + solar noon (toggled by ShowDayLength) -->
                    <Border x:Name="DaySep" Height="1" Background="{DynamicResource BorderBrush}" Margin="0,6,0,6"/>
                    <StackPanel x:Name="DayLengthPanel">
                        <TextBlock FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}"><Run Text="{DynamicResource SunMoon_DayLength}"
                                        Foreground="{DynamicResource MutedTextBrush}"/><Run Text=": "
                                        Foreground="{DynamicResource MutedTextBrush}"/><Run x:Name="DayLengthRun" FontWeight="SemiBold"/><Run x:Name="DayDiffRun"
                                        Foreground="{DynamicResource MutedTextBrush}"/><Run Text="  ·  "
                                        Foreground="{DynamicResource MutedTextBrush}"/><Run Text="{DynamicResource SunMoon_SolarNoon}"
                                        Foreground="{DynamicResource MutedTextBrush}"/><Run Text=": "
                                        Foreground="{DynamicResource MutedTextBrush}"/><Run x:Name="SolarNoonRun" FontWeight="SemiBold"/></TextBlock>
                    </StackPanel>

                    <!-- Golden + blue hour (toggled by ShowGoldenBlue) -->
                    <Border x:Name="GoldenSep" Height="1" Background="{DynamicResource BorderBrush}" Margin="0,6,0,6"/>
                    <StackPanel x:Name="GoldenBluePanel">
                        <TextBlock FontSize="12" FontWeight="SemiBold" TextAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}"><Run Text="{DynamicResource SunMoon_GoldenHour}"/><Run Text=":"/></TextBlock>
                        <TextBlock x:Name="GoldenHourText" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock FontSize="12" FontWeight="SemiBold" TextAlignment="Center" Margin="0,4,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"><Run Text="{DynamicResource SunMoon_BlueHour}"/><Run Text=":"/></TextBlock>
                        <TextBlock x:Name="BlueHourText" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>

                    <!-- Moon disc + phase (toggled by ShowMoon) -->
                    <Border x:Name="MoonSep" Height="1" Background="{DynamicResource BorderBrush}" Margin="0,6,0,6"/>
                    <StackPanel x:Name="MoonCore">
                        <Grid HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="34" Height="34" Margin="0,0,10,0"
                                  VerticalAlignment="Center">
                                <Ellipse x:Name="MoonDisk"
                                         Fill="{DynamicResource BackgroundBrush}"
                                         Stroke="{DynamicResource BorderBrush}"
                                         StrokeThickness="1"/>
                                <Path x:Name="MoonLitPath"
                                      Fill="{DynamicResource PrimaryTextBrush}"/>
                            </Grid>

                            <TextBlock Grid.Column="1" x:Name="MoonPhaseText" Text=""
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </Grid>
                        <TextBlock x:Name="MoonIllumText" Text=""
                                   FontSize="11" Margin="0,2,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Moon extra: rise/set + next new/full (toggled by ShowMoonExtra) -->
                    <Border x:Name="MoonExtraSep" Height="1" Background="{DynamicResource BorderBrush}" Margin="0,6,0,6"/>
                    <StackPanel x:Name="MoonExtraPanel">
                        <TextBlock x:Name="MoonRiseSetText" FontSize="12" Margin="0,2,0,0"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="MoonNextText" FontSize="12" Margin="0,1,0,0"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>

                    <TextBlock x:Name="ErrorText"
                               Visibility="Collapsed"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
