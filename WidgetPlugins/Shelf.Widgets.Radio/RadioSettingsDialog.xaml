<Window x:Class="Shelf.Widgets.Radio.RadioSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Radio_Settings_Title}"
        Height="510" Width="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{DynamicResource UiFont}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{DynamicResource Radio_Section_Stations}"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Margin="0,0,0,8"/>

            <ListBox x:Name="StationList"
                     Height="160"
                     DisplayMemberPath="Name"
                     Background="{DynamicResource ElevatedSurfaceBrush}"
                     BorderBrush="{DynamicResource BorderBrush}"
                     BorderThickness="1"
                     SelectionChanged="StationList_SelectionChanged"/>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="{DynamicResource Radio_Add}"
                        Click="Add_Click"
                        MinWidth="90"
                        Margin="0,0,8,0"/>
                <Button x:Name="RemoveButton"
                        Content="{DynamicResource Radio_Remove}"
                        Click="Remove_Click"
                        MinWidth="90"/>
            </StackPanel>

            <TextBlock Text="{DynamicResource Radio_Name_Label}"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="13" FontWeight="SemiBold"
                       Margin="0,16,0,6"/>
            <TextBox x:Name="NameBox"
                     Padding="6,4"
                     Background="{DynamicResource ElevatedSurfaceBrush}"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     CaretBrush="{DynamicResource PrimaryTextBrush}"
                     SelectionBrush="{DynamicResource AccentBrush}"
                     BorderBrush="{DynamicResource BorderBrush}"
                     BorderThickness="1"
                     FontSize="12"
                     TextChanged="NameBox_TextChanged"/>

            <TextBlock Text="{DynamicResource Radio_Url_Label}"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="13" FontWeight="SemiBold"
                       Margin="0,12,0,6"/>
            <TextBox x:Name="UrlBox"
                     Padding="6,4"
                     Background="{DynamicResource ElevatedSurfaceBrush}"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     CaretBrush="{DynamicResource PrimaryTextBrush}"
                     SelectionBrush="{DynamicResource AccentBrush}"
                     BorderBrush="{DynamicResource BorderBrush}"
                     BorderThickness="1"
                     FontSize="12"
                     TextChanged="UrlBox_TextChanged"/>

            <TextBlock Text="{DynamicResource Radio_Url_Hint}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="{DynamicResource Btn_Cancel}"
                    Click="Cancel_Click"
                    MinWidth="90"
                    Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Btn_OK}"
                    Click="Ok_Click"
                    MinWidth="90"
                    Background="{DynamicResource AccentBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"/>
        </StackPanel>
    </Grid>
</Window>
