<UserControl x:Class="Shelf.Widgets.Photos.PhotosWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="12,8,12,10"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="2,0,2,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" HorizontalAlignment="Left">
                    <TextBlock x:Name="TitleText"
                               Text="{DynamicResource Photos_Name}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Center"
                               Background="Transparent"
                               Cursor="IBeam"
                               ToolTip="{DynamicResource Tip_Rename}"
                               MouseLeftButtonDown="TitleText_MouseLeftButtonDown">
                        <TextBlock.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{DynamicResource Menu_Rename}" Click="TitleRenameMenuItem_Click">
                                    <MenuItem.Icon>
                                        <Viewbox Width="16" Height="16" Margin="0,0,10,0">
                                            <Path Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                                  Fill="{DynamicResource PrimaryTextBrush}"/>
                                        </Viewbox>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </TextBlock.ContextMenu>
                    </TextBlock>
                    <TextBox x:Name="TitleEdit"
                             Visibility="Collapsed"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Background="{DynamicResource ElevatedSurfaceBrush}"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             CaretBrush="{DynamicResource PrimaryTextBrush}"
                             SelectionBrush="{DynamicResource AccentBrush}"
                             BorderBrush="{DynamicResource AccentBrush}"
                             BorderThickness="1"
                             Padding="4,1"
                             MinWidth="100"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Left"
                             PreviewKeyDown="TitleEdit_PreviewKeyDown"
                             LostFocus="TitleEdit_LostFocus"/>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0">
                    <Button x:Name="PrevButton"
                            Style="{DynamicResource IconButtonSubtle}"
                            Width="20" Height="20"
                            Margin="0,0,2,0"
                            Click="PrevButton_Click"
                            ToolTip="{DynamicResource Tip_PrevPhoto}">
                        <Viewbox Width="10" Height="10">
                            <Path Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Viewbox>
                    </Button>

                    <Button x:Name="PlayPauseButton"
                            Style="{DynamicResource IconButtonSubtle}"
                            Width="20" Height="20"
                            Margin="0,0,2,0"
                            Click="PlayPauseButton_Click"
                            ToolTip="{DynamicResource Tip_Pause}">
                        <Viewbox Width="10" Height="10">
                            <Path x:Name="PlayPauseIconPath"
                                  Data="M14,19H18V5H14M6,19H10V5H6V19Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Viewbox>
                    </Button>

                    <Button x:Name="NextButton"
                            Style="{DynamicResource IconButtonSubtle}"
                            Width="20" Height="20"
                            Margin="0,0,2,0"
                            Click="NextButton_Click"
                            ToolTip="{DynamicResource Tip_NextPhoto}">
                        <Viewbox Width="10" Height="10">
                            <Path Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Viewbox>
                    </Button>

                    <Button x:Name="CopyButton"
                            Style="{DynamicResource IconButtonSubtle}"
                            Width="20" Height="20"
                            Margin="0,0,2,0"
                            Click="CopyButton_Click"
                            ToolTip="{DynamicResource Tip_Copy}">
                        <Viewbox Width="10" Height="10">
                            <Path x:Name="CopyIconPath"
                                  Data="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Viewbox>
                    </Button>

                    <Button x:Name="OpenFolderButton"
                            Style="{DynamicResource IconButtonSubtle}"
                            Width="20" Height="20"
                            Click="OpenFolderButton_Click"
                            ToolTip="{DynamicResource Tip_OpenFolder}">
                        <Viewbox Width="10" Height="10">
                            <Path Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Border x:Name="PhotoContainer"
                        Background="{DynamicResource ElevatedSurfaceBrush}"
                        BorderThickness="0"
                        CornerRadius="4"
                        ClipToBounds="True"
                        SizeChanged="PhotoContainer_SizeChanged"
                        MouseLeftButtonDown="PhotoContainer_MouseLeftButtonDown">
                    <Grid>
                        <!-- Back layer: holds the previous photo during cross-fade transitions. -->
                        <Image x:Name="PhotoImageBack"
                               Stretch="UniformToFill"
                               StretchDirection="Both"
                               SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               RenderTransformOrigin="0.5,0.5"
                               Opacity="0">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="BackScale" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="BackTranslate" X="0" Y="0"/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>

                        <!-- Front layer: the active photo. Ken Burns animation runs on this layer. -->
                        <Image x:Name="PhotoImageFront"
                               Stretch="UniformToFill"
                               StretchDirection="Both"
                               SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="FrontScale" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="FrontTranslate" X="0" Y="0"/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>

                        <StackPanel x:Name="PlaceholderPanel"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <TextBlock x:Name="PlaceholderText"
                                       Text="{DynamicResource Photos_NoFolder}"
                                       FontSize="13"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8"/>
                            <Button x:Name="PlaceholderButton"
                                    Content="{DynamicResource Photos_OpenSettings}"
                                    Padding="12,4"
                                    FontSize="11"
                                    HorizontalAlignment="Center"
                                    Click="PlaceholderButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Darkening overlay - solid black on top of the PhotoContainer; its Opacity
                     is driven by WidgetState.DarkenPercent (0-100%). Collapsed when the percent
                     is 0 or while the placeholder is shown. -->
                <Border x:Name="DarkenOverlay"
                        Background="Black"
                        CornerRadius="4"
                        Opacity="0"
                        IsHitTestVisible="False"
                        Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
