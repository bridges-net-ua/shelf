<Window x:Class="Shelf.Widgets.Photos.PhotosSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Photos_Settings_Title}"
        Height="470" Width="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{DynamicResource UiFont}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{DynamicResource Photos_Folder}"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="13" FontWeight="SemiBold"
                       Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FolderPathBox"
                         Grid.Column="0"
                         Padding="6,4"
                         Background="{DynamicResource ElevatedSurfaceBrush}"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         CaretBrush="{DynamicResource PrimaryTextBrush}"
                         SelectionBrush="{DynamicResource AccentBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         BorderThickness="1"
                         FontSize="12"
                         VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="{DynamicResource Photos_Browse}"
                        MinWidth="80"
                        Margin="8,0,0,0"
                        Click="Browse_Click"/>
            </Grid>

            <CheckBox x:Name="CbIncludeSubfolders"
                      Content="{DynamicResource Photos_IncludeSubfolders}"
                      Margin="0,14,0,14"/>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="{DynamicResource Photos_Order}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="13" FontWeight="SemiBold"
                               Margin="0,0,0,6"/>
                    <ComboBox x:Name="OrderCombo">
                        <ComboBoxItem Content="{DynamicResource Photos_Order_Random}"/>
                        <ComboBoxItem Content="{DynamicResource Photos_Order_DateNewest}"/>
                        <ComboBoxItem Content="{DynamicResource Photos_Order_NameAsc}"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="{DynamicResource Photos_Interval}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="13" FontWeight="SemiBold"
                               Margin="0,0,0,6"/>
                    <ComboBox x:Name="IntervalCombo">
                        <ComboBoxItem Content="{DynamicResource Photos_Interval_5s}" Tag="5"/>
                        <ComboBoxItem Content="{DynamicResource Photos_Interval_15s}" Tag="15"/>
                        <ComboBoxItem Content="{DynamicResource Photos_Interval_30s}" Tag="30"/>
                        <ComboBoxItem Content="{DynamicResource Photos_Interval_1m}" Tag="60"/>
                        <ComboBoxItem Content="{DynamicResource Photos_Interval_5m}" Tag="300"/>
                        <ComboBoxItem Content="{DynamicResource Photos_Interval_15m}" Tag="900"/>
                        <ComboBoxItem Content="{DynamicResource Photos_Interval_Never}" Tag="0"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <TextBlock Text="{DynamicResource Photos_Transition}"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="13" FontWeight="SemiBold"
                       Margin="0,0,0,6"/>
            <ComboBox x:Name="TransitionCombo" Margin="0,0,0,14">
                <ComboBoxItem Content="{DynamicResource Photos_Trans_CrossFade}" Tag="CrossFade"/>
                <ComboBoxItem Content="{DynamicResource Photos_Trans_FadeBlack}" Tag="FadeBlack"/>
                <ComboBoxItem Content="{DynamicResource Photos_Trans_Slide}" Tag="Slide"/>
                <ComboBoxItem Content="{DynamicResource Photos_Trans_None}" Tag="None"/>
            </ComboBox>

            <CheckBox x:Name="CbKenBurns"
                      Content="{DynamicResource Photos_KenBurns}"
                      Margin="0,0,0,8"/>

            <CheckBox x:Name="CbGrayscale"
                      Content="{DynamicResource Photos_Grayscale}"
                      Margin="0,0,0,8"/>

            <Grid Margin="0,0,0,2">
                <TextBlock Text="{DynamicResource Photos_Darken}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="13" FontWeight="SemiBold"
                           HorizontalAlignment="Left"/>
                <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="13"
                           HorizontalAlignment="Right"
                           Text="{Binding Value, ElementName=DarkenSlider, StringFormat={}{0:0}%}"/>
            </Grid>
            <Slider x:Name="DarkenSlider"
                    Minimum="0" Maximum="100"
                    IsSnapToTickEnabled="True"
                    TickFrequency="1"
                    SmallChange="1" LargeChange="10"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="{DynamicResource Btn_Cancel}"
                    Click="Cancel_Click"
                    MinWidth="90"
                    Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Btn_OK}"
                    Click="Ok_Click"
                    MinWidth="90"
                    Background="{DynamicResource AccentBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"/>
        </StackPanel>
    </Grid>
</Window>
