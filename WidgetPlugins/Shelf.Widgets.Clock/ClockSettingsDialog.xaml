<Window x:Class="Shelf.Widgets.Clock.ClockSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Clock_Settings_Title}"
        Height="560" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{DynamicResource UiFont}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="{DynamicResource Clock_Section_Time}"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="0,0,0,10"/>
                <CheckBox x:Name="CbShowTime"
                          Content="{DynamicResource Clock_ShowTime}"
                          Margin="0,0,0,10"/>
                <StackPanel Margin="24,0,0,18"
                            IsEnabled="{Binding IsChecked, ElementName=CbShowTime}">
                    <CheckBox x:Name="Cb24Hour"
                              Content="{DynamicResource Clock_24Hour}"
                              Margin="0,0,0,6"/>
                    <CheckBox x:Name="CbSeconds"
                              Content="{DynamicResource Clock_ShowSeconds}"/>
                </StackPanel>

                <Border Height="1"
                        Background="{DynamicResource BorderBrush}"
                        Margin="0,0,0,18"/>

                <TextBlock Text="{DynamicResource Clock_Section_Dow}"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="0,0,0,10"/>
                <CheckBox x:Name="CbShowDow"
                          Content="{DynamicResource Clock_ShowDow}"
                          Margin="0,0,0,10"/>
                <StackPanel Margin="24,0,0,18"
                            IsEnabled="{Binding IsChecked, ElementName=CbShowDow}">
                    <RadioButton x:Name="RbDowFull"
                                 Content="{DynamicResource Clock_Dow_Full}"
                                 GroupName="DowFormat"
                                 Margin="0,0,0,6"/>
                    <RadioButton x:Name="RbDowShort"
                                 Content="{DynamicResource Clock_Dow_Short}"
                                 GroupName="DowFormat"/>
                </StackPanel>

                <Border Height="1"
                        Background="{DynamicResource BorderBrush}"
                        Margin="0,0,0,18"/>

                <TextBlock Text="{DynamicResource Clock_Section_Date}"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="0,0,0,10"/>
                <CheckBox x:Name="CbShowDate"
                          Content="{DynamicResource Clock_ShowDate}"
                          Margin="0,0,0,10"/>
                <StackPanel Margin="24,0,0,0"
                            IsEnabled="{Binding IsChecked, ElementName=CbShowDate}">
                    <RadioButton x:Name="RbDateLong"
                                 Content="{DynamicResource Clock_Date_Long}"
                                 GroupName="DateFormat"
                                 Margin="0,0,0,6"/>
                    <RadioButton x:Name="RbDateNumeric"
                                 Content="{DynamicResource Clock_Date_Numeric}"
                                 GroupName="DateFormat"
                                 Margin="0,0,0,6"/>
                    <RadioButton x:Name="RbDateIso"
                                 Content="{DynamicResource Clock_Date_Iso}"
                                 GroupName="DateFormat"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="{DynamicResource Btn_Cancel}"
                    Click="Cancel_Click"
                    MinWidth="90"
                    Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Btn_OK}"
                    Click="Ok_Click"
                    MinWidth="90"
                    Background="{DynamicResource AccentBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"/>
        </StackPanel>
    </Grid>
</Window>
