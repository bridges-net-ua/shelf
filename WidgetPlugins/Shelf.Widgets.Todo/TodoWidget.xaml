<UserControl x:Class="Shelf.Widgets.Todo.TodoWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="4"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="2,0,2,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" HorizontalAlignment="Left">
                    <StackPanel x:Name="TitleDisplayPanel" Orientation="Horizontal">
                        <TextBlock x:Name="TitleText"
                                   Text="{DynamicResource Todo_Name}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center"
                                   Background="Transparent"
                                   Cursor="IBeam"
                                   ToolTip="{DynamicResource Tip_Rename}"
                                   MouseLeftButtonDown="TitleText_MouseLeftButtonDown">
                            <TextBlock.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{DynamicResource Menu_Rename}" Click="TitleRenameMenuItem_Click">
                                        <MenuItem.Icon>
                                            <Viewbox Width="16" Height="16" Margin="0,0,10,0">
                                                <Path Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                                      Fill="{DynamicResource PrimaryTextBrush}"/>
                                            </Viewbox>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </TextBlock.ContextMenu>
                        </TextBlock>
                        <TextBlock x:Name="CountText"
                                   Text=" (0)"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBox x:Name="TitleEdit"
                             Visibility="Collapsed"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Background="{DynamicResource ElevatedSurfaceBrush}"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             CaretBrush="{DynamicResource PrimaryTextBrush}"
                             SelectionBrush="{DynamicResource AccentBrush}"
                             BorderBrush="{DynamicResource AccentBrush}"
                             BorderThickness="1"
                             Padding="4,1"
                             MinWidth="100"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Left"
                             PreviewKeyDown="TitleEdit_PreviewKeyDown"
                             LostFocus="TitleEdit_LostFocus"/>
                </Grid>

                <Button Grid.Column="1"
                        x:Name="CopyButton"
                        Style="{DynamicResource IconButton}"
                        Width="24" Height="24"
                        Margin="0,0,0,0"
                        IsEnabled="False"
                        Click="CopyButton_Click"
                        ToolTip="{DynamicResource Tip_Copy}">
                    <Viewbox Width="11" Height="11">
                        <Path x:Name="CopyIconPath"
                              Data="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Viewbox>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,6">
                <TextBox x:Name="NewTaskInput"
                         Padding="8,6"
                         Background="{DynamicResource ElevatedSurfaceBrush}"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         CaretBrush="{DynamicResource PrimaryTextBrush}"
                         SelectionBrush="{DynamicResource AccentBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         BorderThickness="1"
                         FontFamily="{DynamicResource UiFont}"
                         FontSize="13"
                         KeyDown="NewTaskInput_KeyDown"/>
                <TextBlock Text="{DynamicResource Todo_NewTask}"
                           IsHitTestVisible="False"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=NewTaskInput}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <ScrollViewer Grid.Row="2"
                          x:Name="ListScroll"
                          Height="220"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ItemsList"/>
            </ScrollViewer>

            <Button x:Name="ClearCompletedButton"
                    Grid.Row="3"
                    Content="{DynamicResource Todo_ClearCompleted}"
                    HorizontalAlignment="Left"
                    Margin="0,8,0,0"
                    Padding="10,4"
                    FontSize="11"
                    Visibility="Collapsed"
                    Click="ClearCompleted_Click"/>
        </Grid>
    </Border>
</UserControl>
