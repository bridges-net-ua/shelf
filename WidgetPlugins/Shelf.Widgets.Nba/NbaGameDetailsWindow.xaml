<Window x:Class="Shelf.Widgets.Nba.NbaGameDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Nba_Details_Title}"
        Height="520" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{DynamicResource UiFont}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="24,18,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Loading / error placeholder -->
        <TextBlock x:Name="StatusLine"
                   Grid.Row="0"
                   Text=""
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,6"/>

        <!-- Score banner -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                <Image x:Name="AwayLogo"
                       Width="48" Height="48"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4"/>
                <TextBlock x:Name="AwayName"
                           Text=""
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="AwayScore"
                           Text="--"
                           FontSize="32"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="vs"
                       FontSize="16"
                       Foreground="{DynamicResource MutedTextBrush}"
                       VerticalAlignment="Center"
                       Margin="14,0,14,0"/>

            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                <Image x:Name="HomeLogo"
                       Width="48" Height="48"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4"/>
                <TextBlock x:Name="HomeName"
                           Text=""
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="HomeScore"
                           Text="--"
                           FontSize="32"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="VenueLine"
                   Grid.Row="2"
                   Text=""
                   FontSize="11"
                   Foreground="{DynamicResource MutedTextBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <!-- Quarter-by-quarter -->
        <Border Grid.Row="3"
                Background="{DynamicResource ElevatedSurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10,8,10,8"
                Margin="0,0,0,10">
            <Grid x:Name="LineScoreGrid"/>
        </Border>

        <!-- Top players -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource ElevatedSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,8,10,8"
                    Margin="0,0,4,0">
                <StackPanel>
                    <TextBlock x:Name="AwayLeadersHeader"
                               Text=""
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,0,0,4"/>
                    <StackPanel x:Name="AwayLeadersList"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="{DynamicResource ElevatedSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,8,10,8"
                    Margin="4,0,0,0">
                <StackPanel>
                    <TextBlock x:Name="HomeLeadersHeader"
                               Text=""
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,0,0,4"/>
                    <StackPanel x:Name="HomeLeadersList"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer: open ESPN + close -->
        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="OpenInBrowserButton"
                    Grid.Column="0"
                    Content="{DynamicResource Nba_Details_OpenInBrowser}"
                    Click="OpenInBrowserButton_Click"
                    Padding="12,4"/>

            <Button Grid.Column="2"
                    Content="{DynamicResource Btn_OK}"
                    Click="Ok_Click"
                    MinWidth="90"
                    Background="{DynamicResource AccentBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"/>
        </Grid>
    </Grid>
</Window>
