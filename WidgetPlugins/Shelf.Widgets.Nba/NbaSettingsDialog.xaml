<Window x:Class="Shelf.Widgets.Nba.NbaSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Nba_Settings_Title}"
        Height="600" Width="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{DynamicResource UiFont}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{DynamicResource Nba_Settings_Favorites}"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   FontSize="13" FontWeight="SemiBold"
                   Margin="0,0,0,8"/>

        <ListBox x:Name="FavoritesList"
                 Grid.Row="1"
                 Background="{DynamicResource ElevatedSurfaceBrush}"
                 BorderBrush="{DynamicResource BorderBrush}"
                 BorderThickness="1"
                 Foreground="{DynamicResource PrimaryTextBrush}"
                 FontSize="13"/>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="AddCombo"
                      Grid.Column="0"
                      Margin="0,0,8,0"/>
            <Button x:Name="AddButton"
                    Grid.Column="1"
                    Content="{DynamicResource Nba_Settings_AddTeam}"
                    Click="AddButton_Click"
                    Padding="12,4"
                    Margin="0,0,6,0"/>
            <Button x:Name="RemoveButton"
                    Grid.Column="2"
                    Content="{DynamicResource Nba_Settings_RemoveTeam}"
                    Click="RemoveButton_Click"
                    Padding="12,4"/>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <TextBlock Text="{DynamicResource Nba_Settings_DisplaySection}"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="13" FontWeight="SemiBold"
                       Margin="0,0,0,8"/>

            <TextBlock x:Name="LeagueGamesLabel"
                       Text=""
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="12"
                       Margin="0,0,0,4"/>
            <Slider x:Name="LeagueGamesSlider"
                    Minimum="1" Maximum="5"
                    IsSnapToTickEnabled="True"
                    TickFrequency="1"
                    SmallChange="1" LargeChange="1"
                    ValueChanged="LeagueGamesSlider_ValueChanged"/>

            <TextBlock x:Name="LeaguePastLabel"
                       Text=""
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="12"
                       Margin="0,10,0,4"/>
            <Slider x:Name="LeaguePastSlider"
                    Minimum="1" Maximum="5"
                    IsSnapToTickEnabled="True"
                    TickFrequency="1"
                    SmallChange="1" LargeChange="1"
                    ValueChanged="LeaguePastSlider_ValueChanged"/>

            <TextBlock x:Name="FavoriteNextLabel"
                       Text=""
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="12"
                       Margin="0,10,0,4"/>
            <Slider x:Name="FavoriteNextSlider"
                    Minimum="1" Maximum="5"
                    IsSnapToTickEnabled="True"
                    TickFrequency="1"
                    SmallChange="1" LargeChange="1"
                    ValueChanged="FavoriteNextSlider_ValueChanged"/>
        </StackPanel>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="{DynamicResource Btn_Cancel}"
                    Click="Cancel_Click"
                    MinWidth="90"
                    Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Btn_OK}"
                    Click="Ok_Click"
                    MinWidth="90"
                    Background="{DynamicResource AccentBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"/>
        </StackPanel>
    </Grid>
</Window>
