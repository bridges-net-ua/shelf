<Window x:Class="Shelf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Settings_Title}"
        Height="540" Width="500"
        MinHeight="480" MinWidth="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource UiFont}"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="0">
            <TabItem Header="{DynamicResource Settings_Tab_Panel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,24,28,24">
                        <TextBlock Text="{DynamicResource Settings_Section_Position}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Margin="0,0,0,10"
                                   Foreground="{DynamicResource MutedTextBrush}"/>

                        <TextBlock x:Name="MonitorSelectorLabel"
                                   Text="{DynamicResource Settings_Monitor_Label}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Margin="0,0,0,8"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <ComboBox x:Name="CbMonitor"
                                  HorizontalAlignment="Stretch"
                                  Margin="0,0,0,8"
                                  SelectionChanged="CbMonitor_SelectionChanged"/>
                        <TextBlock Text="{DynamicResource Settings_Monitor_Hint}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="{DynamicResource Settings_ScreenSide}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Margin="0,0,0,8"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <RadioButton x:Name="RbLeft" Content="{DynamicResource Settings_Side_Left}" Margin="0,0,24,0" GroupName="Side"/>
                            <RadioButton x:Name="RbRight" Content="{DynamicResource Settings_Side_Right}" GroupName="Side"/>
                        </StackPanel>

                        <TextBlock Margin="0,0,0,6"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="13" FontWeight="SemiBold">
                            <Run x:Name="WidthLabelRun" Text="Ширина: "/>
                            <Run x:Name="WidthValueRun" Text="300"/>
                            <Run x:Name="WidthUnitRun" Text=" px"/>
                        </TextBlock>
                        <Slider x:Name="WidthSlider"
                                Minimum="200" Maximum="400"
                                TickFrequency="10"
                                IsSnapToTickEnabled="True"
                                Margin="0,0,0,24"
                                ValueChanged="WidthSlider_ValueChanged"/>

                        <Border Height="1"
                                Background="{DynamicResource BorderBrush}"
                                Margin="0,0,0,20"/>

                        <TextBlock Text="{DynamicResource Settings_Section_Behavior}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Margin="0,0,0,10"
                                   Foreground="{DynamicResource MutedTextBrush}"/>

                        <CheckBox x:Name="CbAutoHide"
                                  Content="{DynamicResource Settings_AutoHide}"
                                  Margin="0,0,0,6"/>
                        <TextBlock Text="{DynamicResource Settings_AutoHide_Hint}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="24,0,0,16"/>

                        <CheckBox x:Name="CbAutoStart"
                                  Content="{DynamicResource Settings_AutoStart}"
                                  Margin="0,0,0,6"/>
                        <TextBlock Text="{DynamicResource Settings_AutoStart_Hint}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="24,0,0,16"/>

                        <CheckBox x:Name="CbLockOrder"
                                  Content="{DynamicResource Settings_LockOrder}"
                                  Margin="0,0,0,6"
                                  Click="CbLockOrder_Click"/>
                        <TextBlock Text="{DynamicResource Settings_LockOrder_Hint}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="24,0,0,16"/>

                        <CheckBox x:Name="CbMinuteOfSilence"
                                  Content="{DynamicResource Settings_MinuteSilence}"
                                  Margin="0,0,0,6"/>
                        <TextBlock Text="{DynamicResource Settings_MinuteSilence_Hint}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="24,0,0,20"/>

                        <Border Height="1"
                                Background="{DynamicResource BorderBrush}"
                                Margin="0,0,0,20"/>

                        <TextBlock Text="{DynamicResource Settings_Section_Theme}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Margin="0,0,0,10"
                                   Foreground="{DynamicResource MutedTextBrush}"/>

                        <TextBlock Text="{DynamicResource Settings_Theme_Label}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Margin="0,0,0,8"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <ComboBox x:Name="CbTheme"
                                  HorizontalAlignment="Left"
                                  Width="200"
                                  Margin="0,0,0,8"
                                  SelectionChanged="CbTheme_SelectionChanged">
                            <ComboBoxItem x:Name="CbThemeDark"
                                          Content="{DynamicResource Settings_Theme_Dark}"/>
                            <ComboBoxItem x:Name="CbThemeLight"
                                          Content="{DynamicResource Settings_Theme_Light}"/>
                        </ComboBox>
                        <TextBlock Text="{DynamicResource Settings_Theme_Hint}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,0,0,20"/>

                        <Border Height="1"
                                Background="{DynamicResource BorderBrush}"
                                Margin="0,0,0,20"/>

                        <TextBlock Text="{DynamicResource Settings_Section_Language}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Margin="0,0,0,10"
                                   Foreground="{DynamicResource MutedTextBrush}"/>

                        <TextBlock Text="{DynamicResource Settings_Language_Label}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Margin="0,0,0,8"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton x:Name="RbLangUk" Content="Українська" Margin="0,0,24,0" GroupName="Language" Click="RbLang_Click"/>
                            <RadioButton x:Name="RbLangEn" Content="English" GroupName="Language" Click="RbLang_Click"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Settings_Language_Hint}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,0,0,0"/>

                        <Border Height="1"
                                Background="{DynamicResource BorderBrush}"
                                Margin="0,20,0,20"/>

                        <TextBlock Text="{DynamicResource Settings_Section_Backup}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Margin="0,0,0,10"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock Text="{DynamicResource Settings_Backup_Hint}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnExportSettings"
                                    Padding="14,6" Margin="0,0,8,0"
                                    Click="BtnExportSettings_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="15" Height="15" Margin="0,0,8,0"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center"
                                          Fill="{DynamicResource PrimaryTextBrush}"
                                          Data="M23,12L19,8V11H10V13H19V16M1,18V6C1,4.89 1.9,4 3,4H15A2,2 0 0,1 17,6V9H15V6H3V18H15V15H17V18A2,2 0 0,1 15,20H3A2,2 0 0,1 1,18Z"/>
                                    <TextBlock Text="{DynamicResource Settings_Backup_Export}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnImportSettings"
                                    Padding="14,6"
                                    Click="BtnImportSettings_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="15" Height="15" Margin="0,0,8,0"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center"
                                          Fill="{DynamicResource PrimaryTextBrush}"
                                          Data="M14,12L10,8V11H1V13H10V16M20,18V6C20,4.89 19.1,4 18,4H6A2,2 0 0,0 4,6V9H6V6H18V18H6V15H4V18A2,2 0 0,0 6,20H18A2,2 0 0,0 20,18Z"/>
                                    <TextBlock Text="{DynamicResource Settings_Backup_Import}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource Settings_Tab_Widgets}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,20,28,20">
                        <TextBlock Text="{DynamicResource Settings_Instances}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{DynamicResource Settings_Instances_Hint}"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,0,0,10"/>
                        <StackPanel x:Name="WidgetsListPanel"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource Settings_Tab_About}">
                <Grid Margin="20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Верх: іконка, назва, версія, опис -->
                    <StackPanel Grid.Row="0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <Image Source="pack://application:,,,/Shelf;component/Resources/shelf.png"
                               Width="96" Height="96"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource App_Name}"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,4"/>
                        <TextBlock x:Name="AboutVersionText"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   HorizontalAlignment="Center"/>
                        <!-- Update check (portable builds only). Collapsed by default;
                             SetupAbout() reveals and wires it in non-Store builds. -->
                        <StackPanel x:Name="UpdatePanel"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Center"
                                    Margin="0,12,0,0">
                            <Button x:Name="BtnCheckUpdates"
                                    Content="{DynamicResource Update_Check}"
                                    HorizontalAlignment="Center"
                                    Padding="14,6"/>
                            <TextBlock x:Name="UpdateStatusText"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="360"
                                       Visibility="Collapsed"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource About_Description}"
                                   FontSize="12"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="380"
                                   Margin="0,12,0,0"/>
                    </StackPanel>

                    <!-- Низ: розробник, контакт, copyright -->
                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                Margin="0,16,0,0">
                        <TextBlock x:Name="AboutDeveloperText"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock x:Name="AboutContactText"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,6,0,0"/>
                        <TextBlock Text="{DynamicResource About_Copyright}"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,14"
                Background="{DynamicResource SurfaceBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Btn_Cancel}"
                        Click="Cancel_Click"
                        MinWidth="100"
                        Margin="0,0,8,0"/>
                <Button Content="{DynamicResource Btn_OK}"
                        Click="Ok_Click"
                        MinWidth="100"
                        Background="{DynamicResource AccentBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
