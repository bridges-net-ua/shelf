<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Win10 2004 (10.0.19041) target activates WinRT projection — Windows.ApplicationModel.StartupTask
         etc. are reachable from C# without extra NuGet packages. Min OS matches our PerMonitorV2 manifest. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Configurations>Debug;Release;Store</Configurations>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Shelf</RootNamespace>
    <AssemblyName>Shelf</AssemblyName>
    <ApplicationIcon>Resources\shelf.ico</ApplicationIcon>
    <EnableDefaultItems>false</EnableDefaultItems>

    <Version>1.2.0</Version>
    <FileVersion>1.2.0.0</FileVersion>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <Company>Bridges Community</Company>
    <Product>Shelf</Product>
    <Copyright>© 2026 Bridges Community</Copyright>
    <Description>Customizable widget dock for Windows desktop</Description>
  </PropertyGroup>

  <!-- STORE_BUILD swaps undocumented IVirtualDesktopPinnedApps for the polling mover
       (Store Policy 10.2.2 forbids undocumented APIs) and switches AutoStartService
       from HKCU\Run to windows.startupTask extension (HKCU is virtualized inside MSIX). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Store'">
    <DefineConstants>$(DefineConstants);STORE_BUILD</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="App.xaml.cs">
      <DependentUpon>App.xaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="MainWindow.xaml.cs">
      <DependentUpon>MainWindow.xaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="Models\**\*.cs"/>
    <Compile Include="Services\**\*.cs"/>
    <Compile Include="Views\**\*.cs" Exclude="Views\**\*.xaml.cs"/>
    <Compile Include="Views\**\*.xaml.cs">
      <DependentUpon>%(Filename)</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </ApplicationDefinition>
    <Page Include="MainWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="Views\**\*.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\shelf.ico"/>
    <Resource Include="Resources\shelf.png"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="app.manifest"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Shelf.Sdk\Shelf.Sdk.csproj"/>
    <ProjectReference Include="WidgetPlugins\Shelf.Widgets.Clock\Shelf.Widgets.Clock.csproj"/>
    <ProjectReference Include="WidgetPlugins\Shelf.Widgets.Notes\Shelf.Widgets.Notes.csproj"/>
    <ProjectReference Include="WidgetPlugins\Shelf.Widgets.Todo\Shelf.Widgets.Todo.csproj"/>
    <ProjectReference Include="WidgetPlugins\Shelf.Widgets.Photos\Shelf.Widgets.Photos.csproj"/>
    <ProjectReference Include="WidgetPlugins\Shelf.Widgets.Radio\Shelf.Widgets.Radio.csproj"/>
    <ProjectReference Include="WidgetPlugins\Shelf.Widgets.Weather\Shelf.Widgets.Weather.csproj"/>
    <ProjectReference Include="WidgetPlugins\Shelf.Widgets.Timer\Shelf.Widgets.Timer.csproj"/>
    <ProjectReference Include="WidgetPlugins\Shelf.Widgets.Stopwatch\Shelf.Widgets.Stopwatch.csproj"/>
    <ProjectReference Include="WidgetPlugins\Shelf.Widgets.Holidays\Shelf.Widgets.Holidays.csproj"/>
    <ProjectReference Include="WidgetPlugins\Shelf.Widgets.Nba\Shelf.Widgets.Nba.csproj"/>
    <ProjectReference Include="WidgetPlugins\Shelf.Widgets.SunMoon\Shelf.Widgets.SunMoon.csproj"/>
    <ProjectReference Include="WidgetPlugins\Shelf.Widgets.Currency\Shelf.Widgets.Currency.csproj"/>
    <ProjectReference Include="WidgetPlugins\Shelf.Widgets.Html\Shelf.Widgets.Html.csproj"/>
  </ItemGroup>

</Project>
